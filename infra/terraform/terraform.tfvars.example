# Copiez ce fichier en "terraform.tfvars" puis adaptez les valeurs.
# (terraform.tfvars ne doit PAS être envoyé sur GitHub)

# Votre IP publique : obtenez-la avec  curl.exe -s https://checkip.amazonaws.com
admin_ip = "1.2.3.4/32"

# AWS Academy : régions autorisées = us-east-1 ou us-west-2
# aws_region        = "us-east-1"
# instance_type     = "t3.medium"
# enable_aws_backup = false
# public_key_path = "~/.ssh/netmaintain_key.pub"

# Optionnel : domaine géré dans Route 53 (nécessaire pour HTTPS)
# domain_name     = "netmaintain.example.com"
# route53_zone_id = "Z0123456789ABC"
